# EdgeSSH 自托管模式配置模板
# 复制为项目根目录的 .env 并按需修改：cp server/.env.example .env
# 环境变量优先级高于本文件。云端部署（Cloudflare Workers）不使用本文件。

# ---- 网络 ----
# 监听端口与地址
PORT=8787
HOST=0.0.0.0
# 公网入口（GitHub 登录回调、Cookie 校验都依赖它，必须与 OAuth App 回调地址一致）
# 只填 origin，不带路径：https://ssh.example.com
APP_ORIGIN=

# ---- TLS（可选，二选一）----
# 方式一：由本服务直接终止 TLS（自托管无反代时使用）
# TLS_CERT=/etc/ssl/certs/edgessh.pem
# TLS_KEY=/etc/ssl/private/edgessh.key
# 方式二：nginx/Caddy 反代终止 TLS，并按 docs/SERVER_DEPLOY.md 转发

# 是否信任反代传递的 X-Forwarded-For（仅在受控反代后开启，防止伪造客户端 IP）
TRUST_PROXY=false

# ---- 登录方式 ----
# password：完全本地的管理员密码登录，不依赖 GitHub / Cloudflare 任何外部服务（自托管推荐）
# github  ：GitHub OAuth 登录（回调地址填 https://你的域名/auth/callback）
# cloudflare：仅当域名套在 Cloudflare Access 后面时可用
AUTH_PROVIDER=password

# ---- password 模式（二选一，HASH 优先）----
# 方式一（推荐）：PBKDF2 哈希，运行 npm run hash-password 生成
# ADMIN_PASSWORD_HASH=pbkdf2-sha256$210000$xxxx$xxxx
# 方式二：明文密码（.env 已是本机受保护文件，但建议用哈希）
# ADMIN_PASSWORD=至少8位强密码

# ---- github 模式 ----
# GitHub OAuth App 的 Client ID / Secret（回调地址填 https://你的域名/auth/callback）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 唯一允许登录的管理员：填 GitHub 用户名（启动时自动解析数字 ID）
# 也可直接填数字 ID：GITHUB_ADMIN_ID=12345678
GITHUB_ADMIN=

# ---- 安全 ----
# 主机资料加密密钥（32 字节 base64）。
# 留空则首次启动自动生成并保存到 server/data/ENCRYPTION_KEY，
# 丢失该文件后云端存储的主机凭据将无法解密，请备份。
ENCRYPTION_KEY=

# SSH 目标连接超时（毫秒，2000-30000）
CONNECT_TIMEOUT_MS=10000
